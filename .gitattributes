# Normalize line endings: LF in the repository, native in the working tree.
# Without this, contributors on different platforms flip whole files between
# CRLF and LF, which buries real changes in thousands of phantom diff lines.
* text=auto

# Windows-only files that must keep CRLF to stay executable.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf

# Shell scripts must keep LF regardless of platform.
*.sh text eol=lf

# Binary files: never touch.
*.exe binary
*.snk binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.rdb binary
